<script>
(function(){
  var KEY="prom-workbook-done-v1", store={};
  try{ store=JSON.parse(localStorage.getItem(KEY)||"{}"); }catch(e){ store={}; }
  function save(){ try{ localStorage.setItem(KEY, JSON.stringify(store)); }catch(e){} }
  function refresh(){
    var boxes=document.querySelectorAll("input[data-done]"), tot=0, dn=0;
    boxes.forEach(function(b){ var id=b.getAttribute("data-done"); b.checked=!!store[id];
      b.closest(".q").classList.toggle("isdone", b.checked); });
    document.querySelectorAll("[data-chapter-prog]").forEach(function(el){
      var ch=el.getAttribute("data-chapter-prog"), sec=document.getElementById(ch);
      if(!sec) return; var a=sec.querySelectorAll("input[data-done]"), d=0;
      a.forEach(function(x){ if(x.checked) d++; });
      el.textContent=d+" of "+a.length+" practiced";
    });
  }
  document.addEventListener("change", function(e){
    var t=e.target; if(t.matches && t.matches("input[data-done]")){ store[t.getAttribute("data-done")]=t.checked; save(); refresh(); }
  });
  function setAll(open){ document.querySelectorAll(".page.active details.answer").forEach(function(d){ d.open=open; }); }
  document.getElementById("openAll").addEventListener("click", function(){ setAll(true); });
  document.getElementById("closeAll").addEventListener("click", function(){ setAll(false); });
  document.getElementById("printBtn").addEventListener("click", function(){ setAll(true); window.print(); });
  window.addEventListener("beforeprint", function(){ setAll(true); });
  var shellEl=document.querySelector(".shell"), tbtn=document.getElementById("tocToggle"), TKEY="prom-toc-collapsed";
  function setToc(collapsed, save){
    shellEl.classList.toggle("collapsed", collapsed);
    tbtn.setAttribute("aria-expanded", collapsed ? "false" : "true");
    if(save){ try{ localStorage.setItem(TKEY, collapsed ? "1" : "0"); }catch(e){} }
  }
  var savedToc=null; try{ savedToc=localStorage.getItem(TKEY); }catch(e){}
  setToc(savedToc===null ? window.innerWidth<=900 : savedToc==="1", false);
  tbtn.addEventListener("click", function(){ setToc(!shellEl.classList.contains("collapsed"), true); });
  var pages=[].slice.call(document.querySelectorAll(".page"));
  function show(id){
    var el=id?document.getElementById(id):null, pg=el?el.closest(".page"):null;
    if(!pg) pg=pages[0];
    pages.forEach(function(p){ p.classList.toggle("active", p===pg); });
    document.querySelectorAll("[data-sub]").forEach(function(x){ x.classList.toggle("open", x.getAttribute("data-sub")===pg.getAttribute("data-page")); });
    document.querySelectorAll(".tabs a").forEach(function(a){ a.classList.toggle("on", a.getAttribute("data-page")===pg.getAttribute("data-page")); });
    if(el && el!==pg && !el.classList.contains("page")) { el.scrollIntoView({behavior:"instant",block:"start"}); } else { window.scrollTo({top:0,behavior:"instant"}); }
  }
  window.addEventListener("hashchange", function(){ show(location.hash.slice(1)); if(window.innerWidth<=900){ setToc(true,false); } });
  show(location.hash.slice(1));
  refresh();
  var links=document.querySelectorAll(".toc a[href^='#']"), map={};
  links.forEach(function(a){ map[a.getAttribute("href").slice(1)]=a; });
  if("IntersectionObserver" in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ links.forEach(function(l){ l.classList.remove("on"); }); var a=map[e.target.id]; if(a) a.classList.add("on"); } });
    },{rootMargin:"-10% 0px -80% 0px"});
    Object.keys(map).forEach(function(id){ var el=document.getElementById(id); if(el) io.observe(el); });
  }
})();
